# Copy this file to .streamlit/secrets.toml and replace all example values.
# Keep secrets.toml private; it is ignored by Git.

[postgres]
host = "localhost"
port = 5432
dbname = "weedsgalore"
user = "weedsgalore_app"
password = "REPLACE_WITH_DATABASE_PASSWORD"
sslmode = "prefer"

[bootstrap_admin]
username = "admin"
password = "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"
